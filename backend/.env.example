# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_PATH=./data/pki.db

# Cosmian KMS Configuration
KMS_URL=http://localhost:42998
# KMS_API_KEY=your-api-key-here (optional, for authentication)

# CRL Distribution Point URL (for X.509 certificates)
# Format: http://your-domain.com/crl/{caId}.crl
# Example: http://crl.example.com/crl/{caId}.crl
CRL_DISTRIBUTION_URL=http://localhost:3000/crl

# =============================================================================
# OIDC Authentication Configuration
# =============================================================================
# Provider-agnostic OIDC settings. Works with Keycloak, Auth0, Okta, Azure AD, etc.
# Leave OIDC_ISSUER unset to disable authentication (all endpoints become public).

# OIDC Issuer URL - The base URL of your OIDC provider
# Examples by provider:
#   Keycloak:  http://localhost:42997/realms/pki-dev
#   Auth0:     https://your-tenant.auth0.com
#   Okta:      https://your-org.okta.com
#   Azure AD:  https://login.microsoftonline.com/{tenant-id}/v2.0
OIDC_ISSUER=http://localhost:42997/realms/pki-dev

# OIDC Audience - The expected audience claim(s) (typically client_id)
# This should match the client(s) configured in your OIDC provider.
# Multiple audiences can be comma-separated to support both user (SPA) and
# machine-to-machine (M2M) authentication via Client Credentials flow.
# Example: OIDC_AUDIENCE=pki-web,pki-service
OIDC_AUDIENCE=pki-web,pki-service

# OIDC Roles Claim Path - Where to find roles in the JWT token
# Different providers store roles in different claims:
#   Keycloak:  realm_access.roles
#   Auth0:     permissions (or custom namespace like https://myapp.com/roles)
#   Okta:      groups
#   Azure AD:  roles
OIDC_ROLES_CLAIM=realm_access.roles
