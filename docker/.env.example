# =============================================================================
# PKI Manager - Docker Compose Configuration
# =============================================================================
# Copy this file to .env and customize the values for your environment.
# If .env is not present, sensible defaults will be used.

# -----------------------------------------------------------------------------
# Image Configuration
# -----------------------------------------------------------------------------
# Image tag (e.g., latest, v1.0.0, dev)
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Network & Ports Configuration
# -----------------------------------------------------------------------------
# Backend external port (host machine)
BACKEND_EXTERNAL_PORT=3000

# Frontend external port (host machine)
FRONTEND_EXTERNAL_PORT=8080

# KMS external port (host machine)
KMS_EXTERNAL_PORT=9998

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
# Node environment (production, development)
NODE_ENV=production

# Backend server port (inside container)
BACKEND_PORT=3000

# Backend server host
BACKEND_HOST=0.0.0.0

# Frontend URL for CORS (adjust for your domain)
FRONTEND_URL=http://localhost:8080

# Database path (inside container)
DATABASE_PATH=/app/backend/data/pki.db

# CRL Distribution Point URL (public URL for X.509 certificates)
# Format: https://your-api-domain.com/crl
CRL_DISTRIBUTION_URL=http://localhost:3000/crl

# -----------------------------------------------------------------------------
# Cosmian KMS Configuration
# -----------------------------------------------------------------------------
# KMS internal URL (service name in Docker network)
KMS_URL=http://kms:9998

# KMS API key (optional, leave empty if not using authentication)
KMS_API_KEY=

# KMS port (inside container)
KMS_PORT=9998

# KMS log level (trace, debug, info, warn, error)
KMS_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Frontend Build Configuration
# -----------------------------------------------------------------------------
# API URL for frontend to connect to backend
# For local development: http://localhost:3000/trpc
# For production: https://your-domain.com/trpc
VITE_API_URL=http://localhost:3000/trpc

# -----------------------------------------------------------------------------
# OIDC Authentication Configuration (Backend)
# -----------------------------------------------------------------------------
# Leave OIDC_ISSUER unset to disable authentication (all endpoints become public)

# OIDC Issuer URL (provider base URL)
# Examples:
#   Keycloak:  https://keycloak.example.com/realms/pki
#   Auth0:     https://your-tenant.auth0.com
#   Okta:      https://your-org.okta.com
#   Azure AD:  https://login.microsoftonline.com/{tenant-id}/v2.0
# OIDC_ISSUER=

# OIDC Audience (expected audience claim, typically client_id)
# Multiple audiences can be comma-separated for SPA + M2M support
# OIDC_AUDIENCE=pki-web,pki-service

# OIDC Roles Claim (JWT path to roles, provider-specific)
# Keycloak: realm_access.roles | Auth0: permissions | Okta: groups | Azure: roles
# OIDC_ROLES_CLAIM=realm_access.roles

# -----------------------------------------------------------------------------
# Frontend OIDC Configuration (Runtime via config.json)
# -----------------------------------------------------------------------------
# For Docker deployments, mount a config.json file to /usr/share/nginx/html/config.json
# with the following structure:
# {
#   "apiUrl": "https://api.example.com/trpc",
#   "oidc": {
#     "authority": "https://keycloak.example.com/realms/pki",
#     "clientId": "pki-web",
#     "scope": "openid profile email"
#   }
# }
#
# See DEPLOYMENT.md for details on runtime OIDC configuration.
