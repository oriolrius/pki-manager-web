# =============================================================================
# PKI Manager - Docker Compose Configuration
# =============================================================================
# Copy this file to .env and customize the values for your environment.
# If .env is not present, sensible defaults will be used.

# -----------------------------------------------------------------------------
# Image Configuration
# -----------------------------------------------------------------------------
# Image tag (e.g., latest, v1.0.0, dev)
IMAGE_TAG=latest

# -----------------------------------------------------------------------------
# Network & Ports Configuration
# -----------------------------------------------------------------------------
# Backend external port (host machine)
BACKEND_EXTERNAL_PORT=3000

# Frontend external port (host machine)
FRONTEND_EXTERNAL_PORT=8080

# -----------------------------------------------------------------------------
# Backend Configuration
# -----------------------------------------------------------------------------
# Node environment (production, development)
NODE_ENV=production

# Backend server port (inside container)
BACKEND_PORT=3000

# Backend server host
BACKEND_HOST=0.0.0.0

# Browser origins allowed to call the API from another origin (CORS), comma-separated.
# Empty or unset: every origin is allowed. Set it to the origin(s) of the web UI, e.g.
# http://localhost:8080 when the UI (port 8080) calls the API on port 3000, or
# https://pki.example.com when one proxy serves both. Invalid entries stop the backend.
# FRONTEND_URL=http://localhost:8080

# Database path (inside container)
DATABASE_PATH=/app/backend/data/pki.db

# CRL Distribution Point URL (public URL for X.509 certificates)
# Format: https://your-api-domain.com/crl
CRL_DISTRIBUTION_URL=http://localhost:3000/crl

# Reverse proxies allowed to set the client IP via X-Forwarded-For.
# Leave empty if clients reach the backend directly. Behind the frontend nginx
# and/or an edge proxy, list their addresses or networks (see docs/operations/deployment.md).
# TRUST_PROXY=172.18.0.0/16

# -----------------------------------------------------------------------------
# Cosmian KMS Configuration
# -----------------------------------------------------------------------------
# KMS internal URL (service name in Docker network)
KMS_URL=http://kms:9998

# KMS API key (optional, leave empty if not using authentication)
KMS_API_KEY=

# The KMS runs in config-file mode: set its port and log level in kms/kms.toml.

# -----------------------------------------------------------------------------
# Frontend Build Configuration
# -----------------------------------------------------------------------------
# Build argument only: the default API URL compiled into a frontend image that you build
# yourself (docker compose build). It has no effect on the published images.
# To set the API URL at run time, use "apiUrl" in docker/config.json.
# VITE_API_URL=http://localhost:3000/trpc

# -----------------------------------------------------------------------------
# OIDC Authentication Configuration (Backend)
# -----------------------------------------------------------------------------
# Leave OIDC_ISSUER unset to disable authentication (all endpoints become public)

# OIDC Issuer URL (provider base URL)
# Examples:
#   Keycloak:  https://keycloak.example.com/realms/pki
#   Auth0:     https://your-tenant.auth0.com
#   Okta:      https://your-org.okta.com
#   Azure AD:  https://login.microsoftonline.com/{tenant-id}/v2.0
# OIDC_ISSUER=

# OIDC Audience (expected audience claim, typically client_id)
# Multiple audiences can be comma-separated for SPA + M2M support
# OIDC_AUDIENCE=pki-web,pki-service

# Allow admins to export a CA private key as a PKCS#12/JKS keystore (default false).
# When false the keystore download is refused (403 CA_KEY_EXPORT_DISABLED) and hidden in the UI.
# When true only the admin role can do it and every export is audited (ca.export_private_key).
# ALLOW_CA_KEY_EXPORT=false

# OIDC Roles Claim (JWT path to roles, provider-specific)
# Keycloak: realm_access.roles | Auth0: permissions | Okta: groups | Azure: roles
# OIDC_ROLES_CLAIM=realm_access.roles

# Base URL the backend uses to fetch the OIDC discovery document and the JWKS, when it
# cannot reach the issuer URL (for example Keycloak on the Docker network). Tokens must
# still carry OIDC_ISSUER as "iss". Empty: the backend uses OIDC_ISSUER.
# OIDC_DISCOVERY_BASE_URL=http://keycloak:8080/realms/pki

# -----------------------------------------------------------------------------
# SSH CA switches (see docs/ssh/api-contract.md). The values below are the defaults.
# -----------------------------------------------------------------------------
# Allow SSH CA management and signing with no login (OIDC off). Local tests only.
# ALLOW_UNAUTHENTICATED_SSH_CA=false

# Serve the ECIES-encrypted per-host KRL to krl-client (needs ecdsa-P256 host keys).
# SSH_ECIES_ENABLED=false

# Serve the per-host KRL on the fleet API. "false" goes back to the per-CA KRL.
# SSH_HOST_KRL_SERVE=true

# Serve the per-host KRL with no token at /krl/hosts/<id>.bin|.json.
# SSH_HOST_KRL_PUBLIC=false

# On user certificate issue, remove the principals that reach only hosts where the
# identity is blocked; refuse the certificate when no principal stays.
# SSH_BLOCK_ISSUANCE_GATE=false

# -----------------------------------------------------------------------------
# Frontend OIDC Configuration (Runtime via config.json)
# -----------------------------------------------------------------------------
# For Docker deployments, mount a config.json file to /usr/share/nginx/html/config.json
# with the following structure:
# {
#   "apiUrl": "https://api.example.com/trpc",
#   "oidc": {
#     "authority": "https://keycloak.example.com/realms/pki",
#     "clientId": "pki-web",
#     "scope": "openid profile email"
#   }
# }
#
# See docs/operations/oidc.md for details on runtime OIDC configuration.

# OIDC providers using UserInfo roles: resolve groups from UserInfo after validating the access token.
# OIDC_ROLES_SOURCE=userinfo
# OIDC_ROLES_CLAIM=groups

# Optional SCEP / Intune device certificate gateway (separate service).
# See scep/README.md and scep/docs/intune.md; add the matching Compose overlays.
# SCEP_EXTERNAL_PORT=8085
# SCEP_VALIDITY_DAYS=90
# SCEP_IMAGE=ghcr.io/YOUR_OWNER/pki-manager-web/scep:YOUR_VERSION
# SCEP_AUTH_MODE=intune
# SCEP_INTUNE_TENANT_ID=
# SCEP_INTUNE_CLIENT_ID=
# SCEP_INTUNE_CLIENT_SECRET_FILE=./scep-secrets/intune-client-secret
# SCEP_INTUNE_REVOCATION_POLL_SECONDS=60
# Store tokens/secrets in ignored secret files, never as committed values.

# Optional SCEP overlay: existing HTTPS backend API (HTTP only on loopback).
# Configure the reverse proxy and gateway rate limits before enabling SCEP.
SCEP_BACKEND_URL=https://pki.example.com
