{
  "realm": "pki-e2e",
  "enabled": true,
  "displayName": "PKI Manager E2E Testing",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": false,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Administrator role with full access to all operations"
      },
      {
        "name": "user",
        "description": "Regular user role with limited access"
      }
    ]
  },
  "clients": [
    {
      "clientId": "pki-web",
      "name": "PKI Web Application",
      "description": "Public client for SPA web application authentication",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:8080",
      "baseUrl": "/",
      "redirectUris": [
        "http://localhost:8080/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:8080/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "http://localhost:5173",
        "http://127.0.0.1:8080"
      ],
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "roles",
        "email",
        "openid"
      ],
      "optionalClientScopes": [
        "offline_access"
      ]
    }
  ],
  "users": [
    {
      "username": "testadmin",
      "email": "testadmin@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "Test123!",
          "temporary": false
        }
      ],
      "realmRoles": ["admin", "default-roles-pki-e2e"]
    },
    {
      "username": "testuser",
      "email": "testuser@example.com",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Test",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "Test123!",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "default-roles-pki-e2e"]
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "roles",
      "roles": ["admin", "user"]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins"
  ]
}
