# {{ ansible_managed }}
# krl-client config (flat YAML). On-host path defaults already match the
# pki-manager layout, so only server-url is strictly required. The host decrypts
# the ECIES KRL locally with /etc/ssh/ssh_host_ecdsa_key and verifies the
# detached signature against /etc/ssh/ssh-host-ca.pub.
server-url: {{ ssh_ca_base_url }}
host-id: {{ ansible_fqdn }}
{% if ssh_host_cert_krl_client_ca_bundle %}
ca-bundle: {{ ssh_host_cert_krl_client_ca_bundle }}
{% endif %}
