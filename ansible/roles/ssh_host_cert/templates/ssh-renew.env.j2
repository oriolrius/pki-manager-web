# {{ ansible_managed }}
# Runtime config for the unattended host-cert renewal job (ANS-04).
# Root-only (0600): contains the fleet bearer token.
SERVER_URL={{ ssh_ca_api_url }}
FLEET_TOKEN={{ ssh_ca_fleet_token }}
FQDN={{ ansible_fqdn }}
KEY_PATH={{ ssh_host_cert_key_path }}
CERT_PATH={{ ssh_host_cert_cert_path }}
ADDRESSES={{ ansible_all_ipv4_addresses | to_json }}
BUCKET_FORMAT={{ ssh_host_cert_renew_bucket_format }}
VALIDATE_CERTS={{ ssh_host_cert_validate_certs | ternary('true', 'false') }}
RELOAD_METHOD={{ ssh_host_cert_reload_method }}
SSHD_SERVICE={{ ssh_host_cert_sshd_service }}
