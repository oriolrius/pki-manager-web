# yamllint config for the ssh_host_cert role. The only long lines are cron
# command bodies inside `content: |` literal blocks (cron requires the whole
# command on one physical line), so line-length is a warning, not an error.
extends: default

rules:
  line-length:
    max: 200
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
