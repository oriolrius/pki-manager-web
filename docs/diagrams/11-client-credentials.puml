@startuml 11-client-credentials
!include ../ssh/explainer/diagrams/theme-oriolrius.puml
title Machine-to-machine: client credentials flow
participant "Automated\nservice" as svc
participant "Keycloak" as kc
participant "PKI Manager\nAPI" as pki
svc -> kc : ""POST /token""\n""grant_type=client_credentials""\n""client_id=pki-service, client_secret=…""
kc --> svc : ""{ access_token }""
svc -> pki : API call with Bearer token
@enduml
