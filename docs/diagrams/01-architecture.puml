@startuml 01-architecture
!include ../ssh/explainer/diagrams/theme-oriolrius.puml
title PKI Manager architecture
actor "Operator" as op
rectangle "React SPA\n(web UI)" as spa <<machine>>
rectangle "OIDC provider\n(optional)" as idp <<file>>
rectangle "**Backend** (Fastify)\n/trpc · /api/v1 (REST + Swagger)\n/api/v1/external (integration tokens)" as be <<pki>>
rectangle "OpenBao (PKI Manager build)\nTransit: private keys, signing" as kms <<user>>
database "SQLite\nmetadata, certificates,\nkey references" as db
rectangle "Automation\ncert-manager issuer, SCEP,\nAnsible, scripts" as auto <<machine>>
op --> spa
spa --> idp : login (PKCE)
spa --> be : tRPC + bearer JWT
auto --> be : REST + token
be --> kms : create keys, sign (HTTPS + token)
be --> db
be ..> idp : validate JWT (JWKS)
@enduml
