{
  "name": "pki-manager",
  "version": "3.9.5",
  "private": true,
  "description": "PKI Manager - Web-based Public Key Infrastructure management application",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "mprocs",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r clean && rm -rf node_modules",
    "test:screenshots": "playwright test tests/screenshots.spec.ts",
    "test:screenshots:ui": "playwright test tests/screenshots.spec.ts --ui"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@10.34.5",
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  },
  "pnpm": {
    "overrides": {
      "ajv": "^8.18.0",
      "axios": "^1.16.0",
      "brace-expansion": "^2.0.3",
      "@isaacs/brace-expansion": "^5.0.1",
      "dompurify": "^3.4.11",
      "fast-uri": "^3.1.2",
      "follow-redirects": "^1.16.0",
      "form-data": "^4.0.6",
      "immutable": "3.8.3",
      "js-yaml": "^4.2.0",
      "lodash": "^4.17.23",
      "minimatch@7.4.6": "^7.4.8",
      "qs": "^6.15.2",
      "seroval": "^1.4.1",
      "shell-quote": "^1.8.4",
      "uuid": "^11.1.1",
      "yaml": "^2.8.3"
    }
  }
}
