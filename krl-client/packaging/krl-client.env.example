# /etc/krl-client/krl-client.env — EnvironmentFile for krl-client.service
#
# Every krl-client flag has a KRL_CLIENT_<FLAG> env form (flag upper-cased, '-'->'_').
# A host provisioned from the generated 60-ssh-ca.conf drop-in only needs the URL;
# the on-host path defaults already match (host key, User-CA pubkey, RevokedKeys).
#
# Prefer /etc/krl-client/config.yaml for anything non-secret; this file exists so a
# server URL can be set without shipping a config file. No secret is ever needed
# here — the ECIES private key is read from disk, never passed in.

KRL_CLIENT_SERVER_URL=https://pki.example.com

# Optional overrides (uncomment as needed):
#KRL_CLIENT_HOST_ID=web01.prod.example.com   # default: `hostname -f`
#KRL_CLIENT_TIMEOUT=30s
#KRL_CLIENT_RETRIES=3
