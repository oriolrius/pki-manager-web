# Backend API URL
VITE_API_URL=http://localhost:3000/trpc

# =============================================================================
# OIDC Authentication Configuration
# =============================================================================
# Provider-agnostic OIDC settings. Works with Keycloak, Auth0, Okta, Azure AD, etc.
# Leave VITE_OIDC_AUTHORITY unset to disable authentication.

# OIDC Authority URL - The base URL of your OIDC provider
# Examples by provider:
#   Keycloak:  http://localhost:42997/realms/pki-dev
#   Auth0:     https://your-tenant.auth0.com
#   Okta:      https://your-org.okta.com
#   Azure AD:  https://login.microsoftonline.com/{tenant-id}/v2.0
VITE_OIDC_AUTHORITY=http://localhost:42997/realms/pki-dev

# OIDC Client ID - The client_id configured in your OIDC provider
# Must be a public client with PKCE support for SPA
VITE_OIDC_CLIENT_ID=pki-web

# OIDC Scope - OAuth2 scopes to request (optional)
# Default: "openid profile email"
# VITE_OIDC_SCOPE=openid profile email
