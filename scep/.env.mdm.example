# Generic managed mode for a trusted MDM validation service.
SCEP_AUTH_MODE=webhook
SCEP_MDM_VALIDATION_URL=https://mdm-validator.example/validate-csr
SCEP_MDM_VALIDATION_TOKEN_FILE=/absolute/path/to/validator-token
# Also configure the backend token, KMS connection and RA state as in .env.example.
# The validation service must authorize the exact CSR, including challenge, subject,
# SAN and EKU. Returning HTTP 200 alone never authorizes enrollment.
