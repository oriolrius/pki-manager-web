# Add non-secret settings to your deployment environment; never commit real values.
SCEP_AUTH_MODE=intune
SCEP_INTUNE_TENANT_ID=REPLACE_WITH_TENANT_ID
SCEP_INTUNE_CLIENT_ID=REPLACE_WITH_APP_CLIENT_ID
SCEP_INTUNE_CLIENT_SECRET_FILE=/absolute/path/to/intune-client-secret
SCEP_INTUNE_REVOCATION_POLL_SECONDS=60
# Also configure the backend token, KMS connection and RA state as in .env.example.
# No static SCEP_CHALLENGE is used in Intune mode. The device receives its dynamic
# challenge through its Intune SCEP profile; do not paste one into this template.
