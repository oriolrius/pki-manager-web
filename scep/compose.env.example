# Copy to an ignored local file, e.g. scep/.env, and pass --env-file scep/.env.
# Existing PKI Manager installation: this setup adds only the SCEP service.
SCEP_DOCKER_NETWORK=pki-network
SCEP_BACKEND_URL=http://pki-backend:3000
SCEP_KMS_URL=http://pki-kms:9998
SCEP_NO_PROXY=pki-backend,pki-kms,backend,kms,127.0.0.1,localhost
SCEP_EXTERNAL_PORT=8085
SCEP_VALIDITY_DAYS=90
# Compose provisions the RA on first start; false requires manual provision.
SCEP_AUTO_PROVISION=true
SCEP_RA_AUTO_RENEW=true
# Optional published gateway image; default builds pki-manager-scep:local.
# SCEP_IMAGE=ghcr.io/your-owner/pki-manager-web/scep:latest
# Optional absolute secret-file paths, otherwise docker/scep-secrets/ is used.
# SCEP_BACKEND_TOKEN_FILE=/absolute/path/to/backend-token
# SCEP_KMS_API_KEY_FILE=/absolute/path/to/kms-api-key
# SCEP_CHALLENGE_FILE=/absolute/path/to/challenge
