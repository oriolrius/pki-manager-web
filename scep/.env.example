# Development only. Load explicitly in your shell; the server does not parse .env.
SCEP_AUTH_MODE=shared
SCEP_BACKEND_URL=http://127.0.0.1:52081
# A dedicated CA-bound service token created under Operations > Integrations. Store actual values
# in secret files, not this template. Each secret also supports the direct variable.
SCEP_BACKEND_TOKEN_FILE=/absolute/path/to/backend-token
SCEP_KMS_URL=http://127.0.0.1:42998
# Optional: omit if the KMS does not require authentication.
# SCEP_KMS_API_KEY_FILE=/absolute/path/to/kms-api-key
SCEP_CHALLENGE_FILE=/absolute/path/to/challenge
SCEP_STATE_FILE=./data/ra.json
SCEP_LISTEN=127.0.0.1:8085
SCEP_VALIDITY_DAYS=90
SCEP_RA_AUTO_RENEW=true
