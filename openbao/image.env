# The OpenBao build PKI Manager runs: the PKI Manager fork, pinned by commit.
# One place for every stack (dev, demo, e2e, CI, Kubernetes tests, Compose deployment).
# scripts/openbao-image.sh reads it. Guide: docs/operations/openbao.md
#
# Source for both architectures of the downstream fork release.
OPENBAO_FORK_REPO=https://github.com/oriolrius/openbao.git
OPENBAO_FORK_COMMIT=fcf3d59dd75cfa0f16fe9f57e23ecda793f44c16
OPENBAO_VERSION=2.7.3
# Commit time of OPENBAO_FORK_COMMIT (git log -1 --format=%ct), stamped in `bao version`.
OPENBAO_FORK_COMMIT_EPOCH=1795727101
# Local tag that the stacks use when no published image is set.
OPENBAO_LOCAL_IMAGE=pki-manager-openbao:2.7.3-pki-manager-fcf3d59
# Published image (empty until the fork release workflow publishes it). When set, the
# stacks pull it instead of building: name:tag@sha256:digest.
OPENBAO_PUBLISHED_IMAGE=
